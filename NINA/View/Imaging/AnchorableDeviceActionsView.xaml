<UserControl
    x:Class="NINA.View.AnchorableDeviceActionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:NINA.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mini="clr-namespace:NINA.View.Sequencer.MiniSequencer;assembly=NINA.Sequencer"
    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer"
    xmlns:ns="clr-namespace:NINA.Core.Locale;assembly=NINA.Core"
    xmlns:util="clr-namespace:NINA.Core.Utility;assembly=NINA.Core"
    d:DesignHeight="300"
    d:DesignWidth="300"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <TabControl TabStripPlacement="Top">
            <TabItem Name="Actions" Header="Actions">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="5,10,5,10">
                        <StackPanel Orientation="Vertical">
                            <Border
                                Margin="0,0,0,10"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0">
                                <UniformGrid VerticalAlignment="Center" Columns="2">
                                    <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblDevice}" />
                                    <ComboBox
                                        MinWidth="100"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        ItemsSource="{Binding DeviceTypes}"
                                        SelectedItem="{Binding ActionDeviceType}" />
                                </UniformGrid>
                            </Border>
                            <Border
                                Margin="0,0,0,10"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0">
                                <UniformGrid
                                    VerticalAlignment="Center"
                                    Columns="2"
                                    IsEnabled="{Binding ActionDeviceConnected}">
                                    <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblAction}" />
                                    <ComboBox
                                        MinWidth="100"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        ItemsSource="{Binding SupportedActions, Mode=OneWay}"
                                        SelectedItem="{Binding ActionName, Mode=TwoWay}" />
                                </UniformGrid>
                            </Border>
                            <Border
                                Margin="0,0,0,10"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0">
                                <UniformGrid
                                    VerticalAlignment="Center"
                                    Columns="2"
                                    IsEnabled="{Binding ActionDeviceConnected}">
                                    <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblParameters}" />
                                    <TextBox
                                        MinWidth="150"
                                        Margin="5,0,0,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        Text="{Binding ActionParameters}"
                                        TextAlignment="Left" />
                                </UniformGrid>
                            </Border>
                            <Border
                                Margin="0,0,0,10"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0">
                                <UniformGrid
                                    VerticalAlignment="Center"
                                    Columns="2"
                                    IsEnabled="{Binding ActionDeviceConnected}">
                                    <TextBlock VerticalAlignment="Center" Text="Output" />
                                    <TextBox
                                        MinWidth="150"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        IsReadOnly="True"
                                        Text="{Binding ActionOutput, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </UniformGrid>
                            </Border>

                            <Grid IsEnabled="{Binding ActionDeviceConnected}">
                                <Button Width="100" Command="{Binding DoRunActionCommand}">
                                    <TextBlock
                                        Padding="5,0,5,0"
                                        Foreground="{StaticResource ButtonForegroundBrush}"
                                        Text="Send" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Name="SendCommand" Header="Send Command">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="5,10,5,10">
                        <StackPanel Orientation="Vertical">
                            <Border
                                Margin="0,0,0,10"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0">
                                <UniformGrid VerticalAlignment="Center" Columns="2">
                                    <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblDevice}" />
                                    <ComboBox
                                        MinWidth="100"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        ItemsSource="{Binding DeviceTypes}"
                                        SelectedItem="{Binding SendCommandDeviceType}" />
                                </UniformGrid>
                            </Border>
                            <Border
                                Margin="0,0,0,10"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0">
                                <UniformGrid
                                    VerticalAlignment="Center"
                                    Columns="2"
                                    IsEnabled="{Binding SendCommandDeviceConnected}">
                                    <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblType}" />
                                    <ComboBox
                                        MinWidth="100"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        ItemsSource="{Binding SendCommandTypes}"
                                        SelectedItem="{Binding SendCommandType}" />
                                </UniformGrid>
                            </Border>
                            <Border
                                Margin="0,0,0,10"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0">
                                <UniformGrid
                                    VerticalAlignment="Center"
                                    Columns="2"
                                    IsEnabled="{Binding SendCommandDeviceConnected}">
                                    <TextBlock VerticalAlignment="Center" Text="{ns:Loc LblCommand}" />
                                    <TextBox
                                        MinWidth="150"
                                        Margin="5,0,0,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        Text="{Binding Command}"
                                        TextAlignment="Left" />
                                </UniformGrid>
                            </Border>
                            <Border
                                Margin="0,0,0,10"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0">
                                <UniformGrid
                                    VerticalAlignment="Center"
                                    Columns="2"
                                    IsEnabled="{Binding SendCommandDeviceConnected}">
                                    <TextBlock VerticalAlignment="Center" Text="Output" />
                                    <TextBox
                                        MinWidth="150"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        IsReadOnly="True"
                                        Text="{Binding SendCommandOutput, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </UniformGrid>
                            </Border>

                            <Grid IsEnabled="{Binding SendCommandDeviceConnected}">
                                <Button Width="100" Command="{Binding DoRunSendCommand}">
                                    <TextBlock
                                        Padding="5,0,5,0"
                                        Foreground="{StaticResource ButtonForegroundBrush}"
                                        Text="Send" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </ScrollViewer>
</UserControl>
